    "gen-icons": "node scripts/gen-icons.mjs"
  },
  "dependencies": {
    "dexie": "^4.0.8",
    "dexie-react-hooks": "^1.1.7",
    "pako": "^2.1.0",
    "qrcode": "^1.5.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.26.2",
    "tesseract.js": "^5.1.1",
    "zustand": "^4.5.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.48.0",
    "@tailwindcss/forms": "^0.5.9",
    "@tcgdex/sdk": "^2.9.0",
    "@tesseract.js-data/eng": "^1.0.0",
    "@types/node": "^22.7.5",
    "@types/pako": "^2.0.3",
    "@types/qrcode": "^1.5.5",
