{
  "name": "pokevault",
  "private": true,
  "version": "0.1.5",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "copy-tesseract": "node scripts/copy-tesseract.mjs",
    "build": "npm run copy-tesseract && tsc -b && vite build",
